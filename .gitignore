# build output (regenerated by make)
project/AT32_IDE/Debug/
project/AT32_IDE/Release/

# Eclipse CDT workspace/indexer cache (machine-specific, auto-regenerates on import)
project/AT32_IDE/.settings/

# debug adapter scratch config regenerated per debug session
project/AT32_IDE/tmp_dap_interface.cfg

# stray physical duplicates Eclipse/AT32 IDE sometimes materializes alongside
# its virtual linked-resource folders - the real sources live in
# libraries/, middlewares/, and project/src/ instead
project/AT32_IDE/cmsis/*.c
project/AT32_IDE/firmware/*.c
project/AT32_IDE/middlewares/**/*.c
project/AT32_IDE/usbd_class/*.c
project/AT32_IDE/user/*.c

# Claude Code session/tooling metadata
.claude/

# OS/editor cruft
Thumbs.db
.DS_Store
*~
